#!/usr/bin/env bash
# Claude Stop/PostToolUse hook: relay-hook FIRSTMATE_HOME.
# Reports blocked eligible relays once per condition through Claude systemMessage.
set -u
home=${1:?firstmate home required}
[ -z "${FM_TASK_ID:-}" ] && [ -f "$home/config/relay-lite.json" ] || exit 0
# shellcheck source=/dev/null
. "$home/bin/fm-primary-scope-lib.sh" || exit 1
# shellcheck source=/dev/null
. "$home/bin/fm-session-lock-lib.sh" || exit 1
fm_primary_scope_matches "$home" "$home/state" >/dev/null 2>&1 || exit 0
ownership=owned
if ! fm_session_lock_owned_by_self "$home/state"; then
  fm_session_lock_inspect "$home/state"
  ownership=${FM_LOCK_INSPECT_STATE:-unknown}
fi
# Python resolves symlinks portably; macOS readlink has no portable -f option.
here=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve().parent)' "${BASH_SOURCE[0]}") || exit 1
exec python3 -B "$here/relay.py" --home "$home" --hook --ownership "$ownership"
