#!/usr/bin/env bash
# relay FIRSTMATE_HOME HARNESS MODEL EFFORT   ('-' keeps the harness default)
# Firstmate primary relay, run by the primary itself after /stow:
# open a sibling Herdr pane, start the harness there as firstmate, and close
# this pane (ending this session) only once the new harness is working on that
# instruction. If the new harness sits idle for 20 s (a startup dialog waiting
# for an answer) or is not working within RELAY_WAIT_SECONDS (600), this pane
# stays open, the new pane's screen is printed, and the exit status is 1.
set -eu
home=${1:?firstmate home} harness=${2:?harness: claude or codex} model=${3:?model} effort=${4:?effort}
pane=${HERDR_PANE_ID:?relay must run inside a Herdr pane}
# The old session holds the lock until it exits, so this session opened read-only:
# its first step waits for that process and runs session start in the foreground.
old=$(herdr pane process-info --pane "$pane" |
  python3 -c 'import json, sys; print(json.load(sys.stdin)["result"]["process_info"]["foreground_processes"][0]["pid"])')
prompt="Take the firstmate role. First run this in the foreground, in the host context outside any tool sandbox (the lock follows real process ancestry), with a 15 minute tool timeout, because the previous primary held the lock when this session opened: \`(cd $home && while kill -0 $old 2>/dev/null; do sleep 1; done && FM_SESSION_START_TIMEOUT=600 bin/fm-session-start.sh)\` Then read the stow result and the current state, and keep every pending item."
case $harness in
  claude) cmd=(claude) m=(--model "$model") e=(--effort "$effort") ;;
  codex) cmd=(codex --no-daemon) m=(-m "$model") e=(-c "model_reasoning_effort=$effort") ;;  # own process tree, so Firstmate can anchor the lock
  *) echo "relay: unsupported harness '$harness' (claude or codex)" >&2; exit 2 ;;
esac
[ "$model" = - ] || cmd+=("${m[@]}")
[ "$effort" = - ] || cmd+=("${e[@]}")
cmd+=("$prompt")
new=$(herdr pane split "$pane" --direction right --cwd "$home" --no-focus |
  python3 -c 'import json, sys; print(json.load(sys.stdin)["result"]["pane"]["pane_id"])')
herdr pane run "$new" "cd $(printf %q "$home") && $(printf '%q ' "${cmd[@]}")"
idle=0
for _ in $(seq "${RELAY_WAIT_SECONDS:-600}"); do
  state=$(herdr pane get "$new" | python3 -c \
    'import json, sys; p = json.load(sys.stdin)["result"]["pane"]; print(p.get("agent"), p.get("agent_status"))')
  case $state in "$harness working" | "$harness done")
    herdr pane close "$pane"
    exit 0 ;;
  "$harness idle") idle=$((idle + 1)); [ "$idle" -lt 20 ] || break ;;
  *) idle=0 ;;
  esac
  sleep 1
done
echo "relay: the new $harness in pane $new is not working ($state); this primary stays. Answer any dialog, then close this pane once it works. Its screen:" >&2
herdr pane read "$new" --lines 15 >&2 || true
exit 1
