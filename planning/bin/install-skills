#!/usr/bin/env python3
"""Install user skills, retaining originals and refusing to remove modified files."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import sys
import tempfile

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib'))
from core import bundle
from common import PlanningError

SOURCE = Path(__file__).resolve().parent.parent / 'skills'
NAMES = ('firstmate-planning', 'planning-firstmate-work', 'reviewing-firstmate-plan', 'executing-firstmate-unit')


def digest(path):
    if not path.is_dir() or path.is_symlink():
        return None
    h = hashlib.sha256()
    for item in sorted(path.rglob('*')):
        if item.is_symlink() or not (item.is_file() or item.is_dir()):
            return None
        h.update(str(item.relative_to(path)).encode() + b'\0')
        if item.is_file():
            h.update(item.read_bytes())
    return h.hexdigest()


def main(source):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('install', 'uninstall'))
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args()
    home = Path(os.environ.get('HOME', str(Path.home())))
    roots = (home / '.codex/skills', home / '.claude/skills')
    # Validate the complete operation before modifying either client.
    actions = []
    for root in roots:
        state = root / '.firstmate-planning-install'
        manifest = state / 'manifest.json'
        records = json.loads(manifest.read_text()) if manifest.exists() else {}
        if state.exists() and not manifest.is_file():
            raise RuntimeError(f'invalid installer state: {state}')
        for name in NAMES:
            dest = root / name
            backup = state / name
            old = records.get(name)
            current = digest(dest) if dest.exists() or dest.is_symlink() else None
            if old and old['backup'] and not backup.is_dir():
                raise RuntimeError(f'backup missing: {backup}')
            if old and current != old['digest']:
                raise RuntimeError(f'installed skill changed or missing: {dest}')
            if not old and backup.exists():
                raise RuntimeError(f'unmanaged backup exists: {backup}')
            if not old and (dest.exists() or dest.is_symlink()) and current is None:
                raise RuntimeError(f'unsupported existing skill: {dest}')
            actions.append((root, state, manifest, records, name, dest, backup, old))
    for root, state, manifest, records, name, dest, backup, old in actions:
        if args.action == 'uninstall' and not old:
            continue
        print(f'{args.action}: {dest}' + (f' (backup: {backup})' if not old and dest.exists() else ''))
        if args.dry_run:
            continue
        root.mkdir(parents=True, exist_ok=True)
        state.mkdir(exist_ok=True)
        if args.action == 'install':
            if old and old['digest'] == digest(source / name):
                continue
            if not old and dest.exists():
                shutil.move(str(dest), str(backup))
            elif old:
                shutil.rmtree(dest)
            shutil.copytree(source / name, dest)
            records[name] = {'digest': digest(dest), 'backup': backup.exists()}
        else:
            shutil.rmtree(dest)
            if old['backup']:
                if not backup.exists():
                    raise RuntimeError(f'backup missing: {backup}')
                shutil.move(str(backup), str(dest))
            del records[name]
        manifest.write_text(json.dumps(records, indent=2) + '\n')
    if not args.dry_run:
        for root in roots:
            state = root / '.firstmate-planning-install'
            manifest = state / 'manifest.json'
            if manifest.exists() and not json.loads(manifest.read_text()):
                manifest.unlink()
                state.rmdir()


if __name__ == '__main__':
    try:
        bundle()  # Validate the exact offline payload before touching client skill directories.
        Path.home().mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix='.planning-package-', dir=Path.home()) as tmp:
            source = Path(tmp) / 'skills'
            shutil.copytree(SOURCE, source)
            runtime = source / 'firstmate-planning/runtime'
            package = SOURCE.parents[1]
            for part in ('bin', 'clean-room', 'planning/lib', 'planning/core', 'vendor'):
                shutil.copytree(package / part, runtime / part, ignore=shutil.ignore_patterns('__pycache__', 'tests'))
            shutil.copyfile(package / 'planning/pin.json', runtime / 'planning/pin.json')
            for part in ('LICENSE', 'NOTICE', 'compatibility.json'):
                shutil.copyfile(package / part, runtime / part)
            main(source)
    except (OSError, ValueError, RuntimeError, PlanningError) as exc:
        print(f'install-skills: {exc}', file=sys.stderr)
        sys.exit(1)
