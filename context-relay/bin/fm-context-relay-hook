#!/usr/bin/env bash
# fm-context-relay-hook --home <firstmate-home> <claude|codex> <event>
#
# Hook entry registered by `fm-context-relay install`. It runs Firstmate's own
# primary-scope and session-lock predicates (sourced read-only from the home
# bin/, never copied) before anything else, so only the session that owns the
# home lock is ever measured or warned. Workers and scouts (linked worktrees),
# other sessions opened in the home, and headless supervision engines fail
# that check and stay inert. The lock is never acquired, recovered or written.
#
# Exit status is always 0. Stdout is empty, or one JSON object with
# hookSpecificOutput.additionalContext printed by the Python handler.
#
# The handler gets its parameters through the environment rather than argv,
# because Firstmate's ancestry walk treats an interpreter whose argv names a
# harness as a harness process.
#
# Frequent events (PostToolBatch, PostToolUse, Stop) are gated per session:
# after a run that left no warning pending, the handler writes
# state/context-relay/throttle/<harness>-<session>, and until the epoch in it
# passes those events exit here without the ownership walk, which costs one
# ps call per ancestor. A skipped event only defers measurement; it never
# injects anything. FM_CONTEXT_RELAY_THROTTLE_SECONDS sets the interval
# (default 30, 0 disables it).
set -u

payload=$(cat 2>/dev/null) || payload=''

primary_home=''
if [ "${1:-}" = "--home" ] && [ "$#" -ge 2 ]; then
  primary_home=$2
  shift 2
fi
harness=${1:-}
event=${2:-}
case "$harness" in claude|codex) ;; *) exit 0 ;; esac
case "$event" in ''|*[!A-Za-z]*) exit 0 ;; esac
[ -n "$primary_home" ] || primary_home=${CLAUDE_PROJECT_DIR:-}
[ -n "$primary_home" ] && [ -d "$primary_home" ] || exit 0
state="$primary_home/state"
[ -f "$state/.lock" ] || exit 0

case "$event" in
  PostToolBatch|PostToolUse|Stop)
    re='"session_id"[[:space:]]*:[[:space:]]*"([A-Za-z0-9._-]+)"'
    if [[ ${payload:0:8192} =~ $re ]]; then
      gate="$state/context-relay/throttle/$harness-${BASH_REMATCH[1]}"
      # A live threshold file must be read on every hook, without restart.
      if [ -f "$gate" ] && [ ! -e "$primary_home/config/umbrales-relevo" ]; then
        next=''
        read -r next < "$gate" 2>/dev/null || true
        case "$next" in ''|*[!0-9]*) next=0 ;; esac
        [ "$(date +%s)" -lt "$next" ] && exit 0
      fi
    fi
    ;;
esac

command -v python3 >/dev/null 2>&1 || exit 0
[ -f "$primary_home/bin/fm-primary-scope-lib.sh" ] && [ -f "$primary_home/bin/fm-session-lock-lib.sh" ] || exit 0
# shellcheck source=/dev/null
. "$primary_home/bin/fm-primary-scope-lib.sh" 2>/dev/null || exit 0
# shellcheck source=/dev/null
. "$primary_home/bin/fm-session-lock-lib.sh" 2>/dev/null || exit 0
fm_primary_scope_matches "$primary_home" "$state" >/dev/null 2>&1 || exit 0
fm_session_lock_owned_by_self "$state" >/dev/null 2>&1 || exit 0

src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname -- "$src")" && pwd)
  src=$(readlink -- "$src")
  case "$src" in /*) ;; *) src=$dir/$src ;; esac
done
here=$(cd -P "$(dirname -- "$src")" && pwd)

owner=''
read -r owner < "$state/.lock" 2>/dev/null || true
FM_CONTEXT_RELAY_HOME=$primary_home
FM_CONTEXT_RELAY_HARNESS=$harness
FM_CONTEXT_RELAY_EVENT=$event
FM_CONTEXT_RELAY_CLI="$here/fm-context-relay"
FM_CONTEXT_RELAY_OWNER_PID=$owner
export FM_CONTEXT_RELAY_HOME FM_CONTEXT_RELAY_HARNESS FM_CONTEXT_RELAY_EVENT FM_CONTEXT_RELAY_CLI FM_CONTEXT_RELAY_OWNER_PID
printf '%s' "$payload" | python3 -I "$here/../lib/fm_context_relay_main.py" hook 2>/dev/null
exit 0
