#!/usr/bin/env bash
# Observe Claude's context_window_size without changing the existing status line.
# Usage: fm-context-relay-statusline --home HOME --forward 'existing command'
# Observation failures are silent; the original status command keeps its stdin.
set -u
[ "${1:-}" = --home ] && [ "$#" -ge 2 ] || exit 0
relay_home=$2
shift 2
forward=''
if [ "${1:-}" = --forward ] && [ "$#" -ge 2 ]; then forward=$2; fi
payload=$(cat 2>/dev/null) || payload=''
here=$(cd -P "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
printf '%s' "$payload" | "$here/fm-context-relay-hook" --home "$relay_home" claude StatusLine >/dev/null 2>&1 || true
if [ -n "$forward" ]; then
  printf '%s' "$payload" | bash -c "$forward"
fi
exit 0
